<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest overlay: points the app at a network security config that
     permits cleartext HTTP (the provider's portal and streams are plain HTTP).
     Release builds do not get this overlay. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
