<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest overlay:
     - network security config that permits cleartext HTTP (the provider has no HTTPS; TLS
       validation is untouched; see docs/private/PHASE2_PROBE_PLAN.md section 9);
     - the debug player activity, started with:
         adb shell am start -n io.github.ravindren_sm.openstream/.DebugPlayerActivity
       Release builds get neither. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- DebugApp attaches the portal traffic logger (PortalTrafficLog) at start-up. -->
    <application
        android:name=".DebugApp"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".DebugPlayerActivity"
            android:exported="true" />
        <activity
            android:name=".KeystoreSelfTestActivity"
            android:exported="true" />
        <activity
            android:name=".EpgProbeActivity"
            android:exported="true" />
        <activity
            android:name=".VodShapeProbeActivity"
            android:exported="true" />
        <activity
            android:name=".ProfilesSelfTestActivity"
            android:exported="true" />
    </application>
</manifest>
